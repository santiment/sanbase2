<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED ''>
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED '' domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  ImageMagick security policy for the sanbase runtime image.
  Installed over /etc/ImageMagick-6/policy.xml by the Dockerfile.

  Our only ImageMagick use is resizing raster images via Mogrify
  (Sanbase.FileStore.Image, SanbaseWeb.UploadImageLive, CoinMarketCap logo fetcher):
    convert <input> -resize NxN -type PaletteAlpha <output.png>

  Uploaded files are stored without an extension, so ImageMagick picks the decoder
  from the file contents. Without this policy any of its ~130 coders can be reached
  by an uploaded file, including SVG/MVG/MSL, which render text with
  arbitrary fonts through FreeType and therefore reach libbrotli's decoder (WOFF2),
  see CVE-2026-111497. Only the raster formats we actually handle are allowed.
-->
<policymap>
  <!-- Resource limits, same as the Debian defaults -->
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="disk" value="1GiB"/>

  <!-- No external programs (ghostscript, ffmpeg, ...) -->
  <policy domain="delegate" rights="none" pattern="*"/>
  <!-- No reading file lists / arguments from files ("@file") -->
  <policy domain="path" rights="none" pattern="@*"/>

  <!-- Deny every coder, then allow only the raster formats we use -->
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read|write" pattern="{GIF,JPEG,PNG,WEBP}"/>
</policymap>
